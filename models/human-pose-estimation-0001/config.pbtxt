name: "human-pose-estimation-0001"
platform: "openvino"
max_batch_size: 0

# The IR is the Open Model Zoo FP32 variant: input data is f32 [1,3,256,456]
# (constants are f16-compressed, but the model input/output are FP32), so the
# config declares FP32 shapes that match the IR exactly.
input: [
  {
    name: "data"
    data_type: TYPE_FP32
    dims: [ 1, 3, 256, 456 ]
  }
]

output: [
  {
    name: "Mconv7_stage2_L1"
    data_type: TYPE_FP32
    dims: [ 1, 38, 32, 57 ]
  },
  {
    name: "Mconv7_stage2_L2"
    data_type: TYPE_FP32
    dims: [ 1, 19, 32, 57 ]
  }
]

version_policy: { latest { num_versions: 1 } }