name: "postprocess_plugin_b"
backend: "plugin"
max_batch_size: 0
plugin_library: "sample_plugin.dll"
parameters {
  key: "clamp_min"
  value { string_value: "0" }
}
parameters {
  key: "clamp_max"
  value { string_value: "50" }
}
parameters {
  key: "offset"
  value { string_value: "1.0" }
}
input {
  name: "processed"
  data_type: TYPE_FP32
  dims: [ 1, 4 ]
}
output {
  name: "result"
  data_type: TYPE_FP32
  dims: [ 1, 4 ]
}
instance_group {
  count: 1
  kind: KIND_CPU
}
metadata {
  model_id: "postprocess_plugin_b"
  version: "1.0.0"
  intended_use: "Test CPU plugin postprocessing (pipeline B owns clamp[0,50] + offset 1.0)"
  training_dataset_id: "N/A"
  approval_status: "approved"
}
self_test {
  input {
    name: "processed"
    data_type: TYPE_FP32
    dims: [ 1, 4 ]
    data: [ 1.0, 2.0, 3.0, 4.0 ]
  }
  expected_output {
    name: "result"
    data_type: TYPE_FP32
    dims: [ 1, 4 ]
    data: [ 2.0, 3.0, 4.0, 5.0 ]
  }
  epsilon: 0.0001
}
