name: "ensemble_pipeline_b"
backend: "ensemble"
max_batch_size: 0
input {
  name: "raw"
  data_type: TYPE_FP32
  dims: [ 1, 4 ]
}
output {
  name: "result"
  data_type: TYPE_FP32
  dims: [ 1, 4 ]
}
instance_group {
  count: 1
  kind: KIND_CPU
}
ensemble_scheduling {
  step {
    model_name: "preprocess_plugin_b"
    input_map { raw: "raw" }
    output_map { normalized: "normalized" }
  }
  step {
    model_name: "sample_model"
    input_map { input: "normalized" }
    output_map { add: "y" }
  }
  step {
    model_name: "postprocess_plugin_b"
    input_map { processed: "y" }
    output_map { result: "result" }
  }
}
metadata {
  model_id: "ensemble_pipeline_b"
  version: "1.0.0"
  intended_use: "Test second CPU ensemble pipeline with its own pre/post processing"
  training_dataset_id: "N/A"
  approval_status: "approved"
}
