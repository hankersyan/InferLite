# Intel GPU model example (Phase 4).
# Requires a precompiled blob: models/intel_gpu_model/1/model.gpu_blob
# produced with ov::Core::compile_model(ir, "GPU").export_model().
name: "intel_gpu_model"
backend: "openvino"
max_batch_size: 0
input {
  name: "input"
  data_type: TYPE_FP32
  dims: [ 1, 3, 224, 224 ]
}
output {
  name: "output"
  data_type: TYPE_FP32
  dims: [ 1, 1000 ]
}
instance_group {
  count: 1
  kind: KIND_GPU_INTEL
}
