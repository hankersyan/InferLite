# Intel NPU model example (Phase 4).
# Requires a precompiled blob: models/intel_npu_model/1/model.npu_blob
# produced with: ovc --compress_to_fp16 ... or ov::compile_model(...).export_model()
name: "intel_npu_model"
backend: "openvino"
max_batch_size: 0
input {
  name: "input"
  data_type: TYPE_FP32
  dims: [ 1, 3, 224, 224 ]
}
output {
  name: "output"
  data_type: TYPE_FP32
  dims: [ 1, 1000 ]
}
instance_group {
  count: 2
  kind: KIND_NPU
}
