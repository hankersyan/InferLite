# Intel AUTO device-selection model example (Phase 4).
# OpenVINO AUTO selects the best available Intel device (NPU > GPU > CPU) at
# load time. May import an existing blob for the selected device or compile the
# IR. In validated mode a blob is mandatory for deterministic behavior.
name: "intel_auto_model"
backend: "openvino"
max_batch_size: 0
input {
  name: "input"
  data_type: TYPE_FP32
  dims: [ 1, 3, 224, 224 ]
}
output {
  name: "output"
  data_type: TYPE_FP32
  dims: [ 1, 1000 ]
}
instance_group {
  count: 2
  kind: KIND_AUTO
}
