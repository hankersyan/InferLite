# Intel auto model (Phase 4).
# OpenVINO AUTO selects best available Intel device.
name: "intel_auto_model"
backend: "openvino"
max_batch_size: 0
input {
  name: "input"
  data_type: TYPE_FP32
  dims: [ 1, 4 ]
}
output {
  name: "add"
  data_type: TYPE_FP32
  dims: [ 1, 4 ]
}
instance_group {
  count: 2
  kind: KIND_AUTO
}
