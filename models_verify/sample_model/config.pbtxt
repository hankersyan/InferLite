name: "sample_model"
backend: "openvino"
max_batch_size: 0
input: [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 4 ]
  }
]
output: [
  {
    name: "add"
    data_type: TYPE_FP32
    dims: [ 1, 4 ]
  }
]
# Phase 4: Triton-style kind selects the execution device (Intel CPU).
instance_group {
  count: 2
  kind: KIND_CPU
}
